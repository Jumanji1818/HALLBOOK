# =============================================================================
# HallBook Environment Variables
# =============================================================================
# Copy this file to .env and fill in values as needed.
# For local development most values can be left as-is or empty.

# Optional: Google Gemini API key (only required if AI features are enabled)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Public URL of the application (used for links / callbacks)
# APP_URL=http://localhost:3000

# Optional: Override the default port (default is 3000)
# PORT=3000

# Optional: Session signing secret (auto-generated if not set)
# SESSION_SECRET=change-me-to-a-long-random-string
